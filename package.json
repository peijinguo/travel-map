{
  "name": "travel-map",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "sync:asari": "node scripts/sync-asari-lift-status.mjs",
    "sync:bankei": "node scripts/sync-bankei-status.mjs",
    "sync:kokusai": "node scripts/sync-kokusai-lift-status.mjs",
    "sync:moiwa": "node scripts/sync-moiwa-lift-status.mjs",
    "sync:teine": "node scripts/sync-teine-lift-status.mjs && node scripts/sync-teine-snow-forecast.mjs",
    "sync:zao": "node scripts/sync-zao-lift-status.mjs",
    "sync:live-data": "npm run sync:asari && npm run sync:bankei && npm run sync:kokusai && npm run sync:moiwa && npm run sync:teine && npm run sync:zao",
    "sync:lift-status": "npm run sync:live-data",
    "predev": "npm run sync:lift-status",
    "dev": "vite",
    "prebuild": "npm run sync:lift-status",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "bootstrap": "^5.3.8",
    "firebase": "^12.17.0",
    "maplibre-gl": "^5.24.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "gh-pages": "^6.3.0",
    "globals": "^17.7.0",
    "sass-embedded": "^1.100.0",
    "vite": "^8.1.1"
  }
}
